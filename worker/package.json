{
  "name": "rosa-parks-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:verify": "wrangler deploy && ./scripts/verify-deploy.sh",
    "verify": "./scripts/verify-deploy.sh",
    "verify:migration": "./scripts/verify-migration.sh",
    "migrate:verify": "wrangler d1 migrations apply rosaparks-beta-signups --remote && ./scripts/verify-migration.sh",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.118.0"
  }
}
